# NimbAI — exemplo de variáveis de ambiente (copie para .env e preencha; .env nunca é commitado)
# Regra: o MCP comunitário (stdio) funciona SEM NENHUMA chave para as fontes abertas.
# Chaves abaixo só são necessárias para fontes condicionais ou para o serviço hospedado.

# --- Identificação obrigatória em APIs públicas ---
# NWS exige User-Agent com contato: "(nimbai.app, contato@nimbai.app)"
NWS_USER_AGENT=

# --- Fontes condicionais (opcional; BYOK) ---
REDEMET_API_KEY=            # radar Brasil (DECEA) — https://redemet.decea.mil.br
EUMETSAT_CONSUMER_KEY=      # EUMETSAT Data Store (Meteosat, MTG-LI)
EUMETSAT_CONSUMER_SECRET=
OPEN_METEO_API_KEY=         # só se usar plano comercial em vez de self-host
XWEATHER_CLIENT_ID=         # premium: raios nuvem-solo (fase 5)
XWEATHER_CLIENT_SECRET=
OWM_API_KEY=                # filler global de radar (fase 5)

# --- Serviço hospedado (apps/api, packages/mcp em Workers) — produção usa `wrangler secret put` ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWKS_URL=
ANTHROPIC_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
TURNSTILE_SECRET=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
TILES_BASE_URL=             # ex.: https://tiles.nimbai.app
