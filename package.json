{
  "name": "nimbai",
  "private": true,
  "version": "0.0.0",
  "description": "NimbAI — weather intelligence for AI agents (MCP) and people (web).",
  "license": "MIT",
  "packageManager": "pnpm@10.0.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "dev:mcp": "pnpm --filter @nimbai/mcp dev",
    "dev:api": "pnpm --filter @nimbai/api dev",
    "dev:web": "pnpm --filter @nimbai/web dev"
  }
}
