{
  "name": "nimbai",
  "private": true,
  "version": "0.0.0",
  "description": "NimbAI \u2014 weather intelligence for AI agents (MCP) and people (web).",
  "license": "MIT",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "dev:mcp": "pnpm --filter @nimbai/mcp dev",
    "dev:api": "pnpm --filter @nimbai/api dev",
    "dev:web": "pnpm --filter @nimbai/web dev"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "prettier": "^3.4.0",
    "tsx": "^4.19.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
